1. Replace/create app/api/picks/submit/route.ts
Path should be:

your-project/app/api/picks/submit/route.ts
Remember: that is inside your inner Next.js app/ folder.

// app/api/picks/submit/route.ts
import { NextResponse } from "next/server";
import { Prisma } from "@prisma/client";
import { z } from "zod";

import { auth } from "@/auth";
import { prisma } from "@/lib/prisma";

const submitPicksSchema = z.object({
  eventId: z.string().min(1),
  choices: z
    .array(
      z.object({
        fightId: z.string().min(1),
        pickedFighterId: z.string().min(1),
      }),
    )
    .min(1),
});

export async function POST(request: Request) {
  try {
    const session = await auth();

    if (!session?.user?.id) {
      return NextResponse.json(
        {
          error: "You must be logged in to submit picks.",
        },
        {
          status: 401,
        },
      );
    }

    const body = await request.json();
    const parsed = submitPicksSchema.safeParse(body);

    if (!parsed.success) {
      return NextResponse.json(
        {
          error: "Invalid picks submission.",
        },
        {
          status: 400,
        },
      );
    }

    const { eventId, choices } = parsed.data;
    const userId = session.user.id;

    const event = await prisma.event.findUnique({
      where: {
        id: eventId,
      },
      select: {
        id: true,
        name: true,
        status: true,
        lockAt: true,
        fights: {
          select: {
            id: true,
            fighterAId: true,
            fighterBId: true,
          },
        },
      },
    });

    if (!event) {
      return NextResponse.json(
        {
          error: "Event not found.",
        },
        {
          status: 404,
        },
      );
    }

    if (event.status !== "OPEN") {
      return NextResponse.json(
        {
          error: "Picks are closed for this event.",
        },
        {
          status: 403,
        },
      );
    }

    if (event.lockAt.getTime() <= Date.now()) {
      return NextResponse.json(
        {
          error: "This event is already locked.",
        },
        {
          status: 403,
        },
      );
    }

    if (event.fights.length === 0) {
      return NextResponse.json(
        {
          error: "This event has no fights.",
        },
        {
          status: 400,
        },
      );
    }

    const existingSubmission = await prisma.pickSubmission.findUnique({
      where: {
        userId_eventId: {
          userId,
          eventId,
        },
      },
      select: {
        id: true,
      },
    });

    if (existingSubmission) {
      return NextResponse.json(
        {
          error: "You already submitted picks for this event. Picks are locked.",
        },
        {
          status: 409,
        },
      );
    }

    const fightsById = new Map(
      event.fights.map((fight) => {
        return [fight.id, fight];
      }),
    );

    const submittedFightIds = new Set(choices.map((choice) => choice.fightId));

    if (submittedFightIds.size !== choices.length) {
      return NextResponse.json(
        {
          error: "You submitted duplicate picks for the same fight.",
        },
        {
          status: 400,
        },
      );
    }

    if (choices.length !== event.fights.length) {
      return NextResponse.json(
        {
          error: "You must pick every fight before submitting.",
        },
        {
          status: 400,
        },
      );
    }

    for (const choice of choices) {
      const fight = fightsById.get(choice.fightId);

      if (!fight) {
        return NextResponse.json(
          {
            error: "One of your picks is for a fight that is not in this event.",
          },
          {
            status: 400,
          },
        );
      }

      const pickedFighterBelongsToFight =
        choice.pickedFighterId === fight.fighterAId ||
        choice.pickedFighterId === fight.fighterBId;

      if (!pickedFighterBelongsToFight) {
        return NextResponse.json(
          {
            error: "One of your picks is not a fighter in that fight.",
          },
          {
            status: 400,
          },
        );
      }
    }

    const submission = await prisma.pickSubmission.create({
      data: {
        userId,
        eventId,
        isLocked: true,
        choices: {
          create: choices.map((choice) => ({
            fightId: choice.fightId,
            pickedFighterId: choice.pickedFighterId,
          })),
        },
      },
      select: {
        id: true,
        submittedAt: true,
      },
    });

    return NextResponse.json(
      {
        submission,
      },
      {
        status: 201,
      },
    );
  } catch (error) {
    if (
      error instanceof Prisma.PrismaClientKnownRequestError &&
      error.code === "P2002"
    ) {
      return NextResponse.json(
        {
          error: "You already submitted picks for this event. Picks are locked.",
        },
        {
          status: 409,
        },
      );
    }

    console.error(error);

    return NextResponse.json(
      {
        error: "Failed to submit picks.",
      },
      {
        status: 500,
      },
    );
  }
}
This is the real lock. Even if someone tries to spam the endpoint manually, the API rejects the second submission.

2. Replace components/picks/FightAccordion.tsx
This version does two new things:

router.refresh()
submitted state disables the button immediately
// components/picks/FightAccordion.tsx
"use client";

import { useRouter } from "next/navigation";
import { useState } from "react";

import FightCard from "./FightCard";
import SubmitPicksButton from "./SubmitPicksButton";
import type { Fight, PickDraft } from "./types";

type Props = {
  eventId: string;
  fights: Fight[];
};

export default function FightAccordion({ eventId, fights }: Props) {
  const router = useRouter();

  const [selectedPicks, setSelectedPicks] = useState<Record<string, PickDraft>>(
    {},
  );

  const [isSubmitting, setIsSubmitting] = useState(false);
  const [hasSubmitted, setHasSubmitted] = useState(false);

  function selectFighter(fightId: string, fighterId: string) {
    if (hasSubmitted || isSubmitting) {
      return;
    }

    setSelectedPicks((current) => {
      const alreadySelected = current[fightId]?.fighterId === fighterId;

      if (alreadySelected) {
        const updated = { ...current };
        delete updated[fightId];
        return updated;
      }

      return {
        ...current,
        [fightId]: {
          fighterId,
        },
      };
    });
  }

  async function submitPicks() {
    if (hasSubmitted || isSubmitting) {
      return;
    }

    const choices = Object.entries(selectedPicks).map(([fightId, pick]) => ({
      fightId,
      pickedFighterId: pick.fighterId,
    }));

    setIsSubmitting(true);

    try {
      const response = await fetch("/api/picks/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          eventId,
          choices,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        alert(data.error || "Failed to submit picks.");
        return;
      }

      setHasSubmitted(true);
      alert("Picks submitted and locked!");

      router.refresh();
    } catch (error) {
      console.error(error);
      alert("Failed to submit picks.");
    } finally {
      setIsSubmitting(false);
    }
  }

  const totalFights = fights.length;
  const pickedCount = Object.keys(selectedPicks).length;
  const allPicksMade = pickedCount === totalFights;

  return (
    <>
      <div className="space-y-5 pb-32">
        {fights.map((fight) => (
          <FightCard
            key={fight.id}
            fight={fight}
            selectedFighterId={selectedPicks[fight.id]?.fighterId}
            onSelectFighter={selectFighter}
          />
        ))}
      </div>

      <SubmitPicksButton
        pickedCount={pickedCount}
        totalFights={totalFights}
        disabled={!allPicksMade || isSubmitting || hasSubmitted}
        isSubmitting={isSubmitting}
        onSubmit={submitPicks}
      />
    </>
  );
}
3. Optional: improve the submit button text
Replace components/picks/SubmitPicksButton.tsx with this small upgrade.

// components/picks/SubmitPicksButton.tsx
type Props = {
  pickedCount: number;
  totalFights: number;
  disabled: boolean;
  isSubmitting: boolean;
  onSubmit: () => void;
};

export default function SubmitPicksButton({
  pickedCount,
  totalFights,
  disabled,
  isSubmitting,
  onSubmit,
}: Props) {
  const pickPercentage =
    totalFights === 0 ? 0 : Math.round((pickedCount / totalFights) * 100);

  const allPicksMade = pickedCount === totalFights;
  const label = isSubmitting
    ? "Submitting..."
    : disabled && allPicksMade
      ? "Picks Locked"
      : disabled
        ? `Make Picks ${pickedCount}/${totalFights}`
        : "Submit Picks";

  return (
    <div className="fixed bottom-8 left-1/2 z-50 w-54 -translate-x-1/2">
      <button
        type="button"
        disabled={disabled}
        onClick={onSubmit}
        className={`relative w-full overflow-hidden rounded-2xl px-6 py-4 text-center font-bold shadow-lg transition ${
          disabled
            ? "cursor-not-allowed text-white"
            : "cursor-pointer text-white"
        }`}
      >
        <div className="absolute inset-0 bg-neutral-400" />

        <div
          className="absolute inset-y-0 left-0 bg-blue-500 transition-all duration-300"
          style={{ width: `${pickPercentage}%` }}
        />

        <span className="relative z-10">{label}</span>
      </button>
    </div>
  );
}
