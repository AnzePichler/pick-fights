4. Replace components/picks/FighterSide.tsx
This allows the accordion to still open while preventing pick switching.

// components/picks/FighterSide.tsx
import type { Fighter } from "./types";

type Props = {
  fighter: Fighter;
  align: "left" | "right";
  onSelect: () => void;
  isLocked?: boolean;
};

export default function FighterSide({
  fighter,
  align,
  onSelect,
  isLocked = false,
}: Props) {
  const isRight = align === "right";
  const rankLabel = getRankLabel(fighter);

  return (
    <button
      type="button"
      aria-disabled={isLocked}
      onClick={(event) => {
        if (isLocked) {
          return;
        }

        event.preventDefault();
        onSelect();
      }}
      className={`w-full rounded-2xl p-3 transition ${
        isLocked ? "cursor-default" : "hover:bg-zinc-50"
      } ${isRight ? "text-right" : "text-left"}`}
    >
      <div
        className={`flex items-center gap-4 ${isRight ? "justify-end" : ""}`}
      >
        {!isRight && <FighterImage fighter={fighter} />}

        <div className="min-w-0">
          {rankLabel && (
            <p
              className={`inline-flex items-center px-1 text-md font-black ${
                rankLabel === "C"
                  ? "mb-0.5 bg-[#ba922d] text-white"
                  : "bg-transparent text-lg text-gray-400"
              }`}
            >
              {rankLabel}
            </p>
          )}

          <h2 className="text-2xl font-bold text-neutral-800">
            {fighter.name}
          </h2>

          <div
            className={`flex flex-wrap items-center gap-2 text-base font-[510] text-neutral-500 ${
              isRight ? "justify-end" : ""
            }`}
          >
            {!isRight && <CountryFlag fighter={fighter} />}

            <span>{fighter.record || "Record unavailable"}</span>

            {isRight && <CountryFlag fighter={fighter} />}
          </div>
        </div>

        {isRight && <FighterImage fighter={fighter} />}
      </div>
    </button>
  );
}

function FighterImage({ fighter }: { fighter: Fighter }) {
  return (
    <div className="h-36 w-36 shrink-0 overflow-hidden rounded-xl">
      <img
        src={fighter.imageUrl || "/fighter-placeholder.png"}
        alt={fighter.name}
        className="h-full w-full object-cover object-top"
      />
    </div>
  );
}

function CountryFlag({ fighter }: { fighter: Fighter }) {
  if (!fighter.countryFlagUrl) return null;

  return (
    <span className="inline-flex h-5 w-7 shrink-0 overflow-hidden">
      <img
        src={fighter.countryFlagUrl}
        alt={fighter.country || "Country flag"}
        title={fighter.country || undefined}
        className="h-full w-full object-cover"
      />
    </span>
  );
}

function getRankLabel(fighter: Fighter) {
  if (isChampion(fighter)) return "C";
  if (fighter.ranking != null) return `#${fighter.ranking}`;
  return null;
}

function isChampion(fighter: Fighter) {
  const imageUrl = (fighter.imageUrl || "").toUpperCase();
  return imageUrl.includes("BELT");
}
5. Replace components/picks/SubmitPicksButton.tsx
This keeps the same bottom button but shows Picks Locked.

// components/picks/SubmitPicksButton.tsx
type Props = {
  pickedCount: number;
  totalFights: number;
  disabled: boolean;
  isSubmitting: boolean;
  isLocked?: boolean;
  onSubmit: () => void;
};

export default function SubmitPicksButton({
  pickedCount,
  totalFights,
  disabled,
  isSubmitting,
  isLocked = false,
  onSubmit,
}: Props) {
  const pickPercentage =
    totalFights === 0 ? 0 : Math.round((pickedCount / totalFights) * 100);

  const label = isSubmitting
    ? "Submitting..."
    : isLocked
      ? "Picks Locked"
      : disabled
        ? `Make Picks ${pickedCount}/${totalFights}`
        : "Submit Picks";

  return (
    <div className="fixed bottom-8 left-1/2 z-50 w-54 -translate-x-1/2">
      <button
        type="button"
        disabled={disabled}
        onClick={onSubmit}
        className={`relative w-full overflow-hidden rounded-2xl px-6 py-4 text-center font-bold shadow-lg transition ${
          disabled
            ? "cursor-not-allowed text-white"
            : "cursor-pointer text-white"
        }`}
      >
        <div className="absolute inset-0 bg-neutral-400" />

        <div
          className="absolute inset-y-0 left-0 bg-blue-500 transition-all duration-300"
          style={{ width: `${pickPercentage}%` }}
        />

        <span className="relative z-10">{label}</span>
      </button>
    </div>
  );
}
