1. Create app/admin/page.tsx
// app/admin/page.tsx
import { redirect } from "next/navigation";

import { auth } from "@/auth";
import { prisma } from "@/lib/prisma";
import Navbar from "@/components/Navbar";
import AdminResultsForm from "./AdminResultsForm";

export const dynamic = "force-dynamic";

export default async function AdminPage() {
  const session = await auth();

  if (!session?.user?.id) {
    redirect("/login");
  }

  if (session.user.role !== "ADMIN") {
    redirect("/picks");
  }

  const event = await prisma.event.findFirst({
    where: {
      isActive: true,
    },
    include: {
      fights: {
        include: {
          fighterA: {
            select: {
              id: true,
              name: true,
              imageUrl: true,
              record: true,
            },
          },
          fighterB: {
            select: {
              id: true,
              name: true,
              imageUrl: true,
              record: true,
            },
          },
          result: {
            select: {
              status: true,
              winnerFighterId: true,
              method: true,
              round: true,
            },
          },
        },
        orderBy: {
          order: "asc",
        },
      },
    },
  });

  if (!event) {
    return (
      <>
        <Navbar />

        <main className="min-h-screen bg-zinc-100 p-6 text-black">
          <section className="mx-auto max-w-5xl rounded-3xl bg-white p-8 shadow-sm">
            <h1 className="text-3xl font-black">Admin</h1>
            <p className="mt-2 text-neutral-500">
              No active event found. Mark an event as active first.
            </p>
          </section>
        </main>
      </>
    );
  }

  const adminEvent = {
    id: event.id,
    name: event.name,
    status: event.status,
    fights: event.fights.map((fight) => ({
      id: fight.id,
      order: fight.order,
      fighterA: fight.fighterA,
      fighterB: fight.fighterB,
      result: fight.result,
    })),
  };

  return (
    <>
      <Navbar />

      <main className="min-h-screen bg-zinc-100 p-6 text-black">
        <section className="mx-auto max-w-5xl">
          <div className="mb-6 rounded-3xl bg-white p-6 shadow-sm">
            <h1 className="text-4xl font-black tracking-tight">Admin</h1>

            <p className="mt-2 text-sm font-semibold text-neutral-500">
              Input fight results for {event.name}.
            </p>
          </div>

          <AdminResultsForm event={adminEvent} />
        </section>
      </main>
    </>
  );
}
2. Create app/admin/AdminResultsForm.tsx
// app/admin/AdminResultsForm.tsx
"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";

type FightResultStatus =
  | "PENDING"
  | "WINNER"
  | "DRAW"
  | "NO_CONTEST"
  | "CANCELLED";

type FightMethod = "KO_TKO" | "SUBMISSION" | "DECISION";

type Fighter = {
  id: string;
  name: string;
  imageUrl: string | null;
  record: string | null;
};

type AdminFight = {
  id: string;
  order: number;
  fighterA: Fighter;
  fighterB: Fighter;
  result: {
    status: FightResultStatus;
    winnerFighterId: string | null;
    method: FightMethod | null;
    round: number | null;
  } | null;
};

type AdminEvent = {
  id: string;
  name: string;
  status: string;
  fights: AdminFight[];
};

type ResultDraft = {
  fightId: string;
  status: FightResultStatus;
  winnerFighterId: string | null;
  method: FightMethod | null;
  round: number | null;
};

type Props = {
  event: AdminEvent;
};

export default function AdminResultsForm({ event }: Props) {
  const router = useRouter();

  const [results, setResults] = useState<Record<string, ResultDraft>>(() => {
    const initialResults: Record<string, ResultDraft> = {};

    for (const fight of event.fights) {
      initialResults[fight.id] = {
        fightId: fight.id,
        status: fight.result?.status || "PENDING",
        winnerFighterId: fight.result?.winnerFighterId || null,
        method: fight.result?.method || null,
        round: fight.result?.round || null,
      };
    }

    return initialResults;
  });

  const [isSaving, setIsSaving] = useState(false);
  const [markCompleted, setMarkCompleted] = useState(false);
  const [message, setMessage] = useState<string | null>(null);

  function updateFightResult(fightId: string, resultValue: string) {
    setResults((current) => {
      const currentResult = current[fightId];

      if (resultValue.startsWith("WINNER:")) {
        const winnerFighterId = resultValue.replace("WINNER:", "");

        return {
          ...current,
          [fightId]: {
            ...currentResult,
            status: "WINNER",
            winnerFighterId,
          },
        };
      }

      return {
        ...current,
        [fightId]: {
          ...currentResult,
          status: resultValue as FightResultStatus,
          winnerFighterId: null,
          method: null,
          round: null,
        },
      };
    });
  }

  function updateMethod(fightId: string, method: string) {
    setResults((current) => ({
      ...current,
      [fightId]: {
        ...current[fightId],
        method: method ? (method as FightMethod) : null,
      },
    }));
  }

  function updateRound(fightId: string, round: string) {
    setResults((current) => ({
      ...current,
      [fightId]: {
        ...current[fightId],
        round: round ? Number(round) : null,
      },
    }));
  }

  async function saveResults() {
    setIsSaving(true);
    setMessage(null);

    try {
      const response = await fetch("/api/admin/results", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          eventId: event.id,
          markCompleted,
          results: Object.values(results),
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        setMessage(data.error || "Failed to save results.");
        return;
      }

      setMessage("Results saved.");
      router.refresh();
    } catch (error) {
      console.error(error);
      setMessage("Failed to save results.");
    } finally {
      setIsSaving(false);
    }
  }

  const finishedCount = Object.values(results).filter(
    (result) => result.status !== "PENDING",
  ).length;

  return (
    <div className="space-y-5">
      <div className="rounded-3xl bg-white p-6 shadow-sm">
        <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div>
            <h2 className="text-2xl font-black">Fight results</h2>

            <p className="mt-1 text-sm font-semibold text-neutral-500">
              {finishedCount} / {event.fights.length} fights have results.
            </p>
          </div>

          <label className="flex items-center gap-3 rounded-2xl bg-neutral-100 px-4 py-3 text-sm font-bold text-neutral-700">
            <input
              type="checkbox"
              checked={markCompleted}
              onChange={(event) => setMarkCompleted(event.target.checked)}
              className="h-4 w-4"
            />
            Mark event completed
          </label>
        </div>

        {message && (
          <div className="mt-5 rounded-2xl bg-neutral-100 px-4 py-3 text-sm font-bold text-neutral-700">
            {message}
          </div>
        )}
      </div>

      {event.fights.map((fight) => {
        const result = results[fight.id];
        const selectedValue =
          result.status === "WINNER" && result.winnerFighterId
            ? `WINNER:${result.winnerFighterId}`
            : result.status;

        return (
          <div
            key={fight.id}
            className="overflow-hidden rounded-3xl bg-white shadow-sm"
          >
            <div className="border-b border-neutral-100 bg-neutral-50 px-6 py-4">
              <div className="text-xs font-black uppercase tracking-widest text-neutral-400">
                Fight {fight.order}
              </div>

              <div className="mt-1 text-xl font-black text-neutral-800">
                {fight.fighterA.name} vs {fight.fighterB.name}
              </div>
            </div>

            <div className="grid gap-6 p-6 md:grid-cols-[1fr_auto_1fr] md:items-center">
              <FighterPreview fighter={fight.fighterA} align="left" />

              <div className="text-center text-sm font-black text-neutral-300">
                VS
              </div>

              <FighterPreview fighter={fight.fighterB} align="right" />
            </div>

            <div className="grid gap-4 border-t border-neutral-100 p-6 md:grid-cols-3">
              <label className="space-y-2">
                <span className="text-sm font-black text-neutral-700">
                  Result
                </span>

                <select
                  value={selectedValue}
                  onChange={(event) =>
                    updateFightResult(fight.id, event.target.value)
                  }
                  className="w-full rounded-2xl border border-neutral-200 bg-white px-4 py-3 text-sm font-bold outline-none focus:border-blue-500"
                >
                  <option value="PENDING">Pending</option>
                  <option value={`WINNER:${fight.fighterA.id}`}>
                    {fight.fighterA.name} won
                  </option>
                  <option value={`WINNER:${fight.fighterB.id}`}>
                    {fight.fighterB.name} won
                  </option>
                  <option value="DRAW">Draw</option>
                  <option value="NO_CONTEST">No contest</option>
                  <option value="CANCELLED">
                    Cancelled / did not happen
                  </option>
                </select>
              </label>

              <label className="space-y-2">
                <span className="text-sm font-black text-neutral-700">
                  Method
                </span>

                <select
                  value={result.method || ""}
                  onChange={(event) => updateMethod(fight.id, event.target.value)}
                  disabled={result.status !== "WINNER"}
                  className="w-full rounded-2xl border border-neutral-200 bg-white px-4 py-3 text-sm font-bold outline-none disabled:cursor-not-allowed disabled:bg-neutral-100 disabled:text-neutral-400 focus:border-blue-500"
                >
                  <option value="">Optional</option>
                  <option value="KO_TKO">KO / TKO</option>
                  <option value="SUBMISSION">Submission</option>
                  <option value="DECISION">Decision</option>
                </select>
              </label>

              <label className="space-y-2">
                <span className="text-sm font-black text-neutral-700">
                  Round
                </span>

                <select
                  value={result.round || ""}
                  onChange={(event) => updateRound(fight.id, event.target.value)}
                  disabled={result.status !== "WINNER"}
                  className="w-full rounded-2xl border border-neutral-200 bg-white px-4 py-3 text-sm font-bold outline-none disabled:cursor-not-allowed disabled:bg-neutral-100 disabled:text-neutral-400 focus:border-blue-500"
                >
                  <option value="">Optional</option>
                  <option value="1">Round 1</option>
                  <option value="2">Round 2</option>
                  <option value="3">Round 3</option>
                  <option value="4">Round 4</option>
                  <option value="5">Round 5</option>
                </select>
              </label>
            </div>
          </div>
        );
      })}

      <div className="sticky bottom-6 z-40 flex justify-center">
        <button
          type="button"
          onClick={saveResults}
          disabled={isSaving}
          className="rounded-2xl bg-blue-600 px-8 py-4 font-black text-white shadow-lg transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-neutral-400"
        >
          {isSaving ? "Saving..." : "Save results"}
        </button>
      </div>
    </div>
  );
}

function FighterPreview({
  fighter,
  align,
}: {
  fighter: Fighter;
  align: "left" | "right";
}) {
  const isRight = align === "right";

  return (
    <div
      className={`flex items-center gap-4 ${
        isRight ? "justify-end text-right" : "text-left"
      }`}
    >
      {!isRight && <FighterImage fighter={fighter} />}

      <div>
        <div className="text-lg font-black text-neutral-800">
          {fighter.name}
        </div>

        <div className="text-sm font-semibold text-neutral-400">
          {fighter.record || "Record unavailable"}
        </div>
      </div>

      {isRight && <FighterImage fighter={fighter} />}
    </div>
  );
}

function FighterImage({ fighter }: { fighter: Fighter }) {
  return (
    <div className="h-20 w-20 shrink-0 overflow-hidden rounded-2xl bg-neutral-100">
      <img
        src={fighter.imageUrl || "/fighter-placeholder.png"}
        alt={fighter.name}
        className="h-full w-full object-cover object-top"
      />
    </div>
  );
}

3. Create app/api/admin/results/route.ts
// app/api/admin/results/route.ts
import { NextResponse } from "next/server";
import { z } from "zod";

import { auth } from "@/auth";
import { prisma } from "@/lib/prisma";

const fightResultStatusSchema = z.enum([
  "PENDING",
  "WINNER",
  "DRAW",
  "NO_CONTEST",
  "CANCELLED",
]);

const fightMethodSchema = z.enum(["KO_TKO", "SUBMISSION", "DECISION"]);

const resultSchema = z.object({
  fightId: z.string().min(1),
  status: fightResultStatusSchema,
  winnerFighterId: z.string().nullable(),
  method: fightMethodSchema.nullable(),
  round: z.number().int().min(1).max(5).nullable(),
});

const updateResultsSchema = z.object({
  eventId: z.string().min(1),
  markCompleted: z.boolean().optional().default(false),
  results: z.array(resultSchema).min(1),
});

export async function PATCH(request: Request) {
  try {
    const session = await auth();

    if (!session?.user?.id) {
      return NextResponse.json(
        {
          error: "You must be logged in.",
        },
        {
          status: 401,
        },
      );
    }

    if (session.user.role !== "ADMIN") {
      return NextResponse.json(
        {
          error: "You are not allowed to update results.",
        },
        {
          status: 403,
        },
      );
    }

    const body = await request.json();
    const parsed = updateResultsSchema.safeParse(body);

    if (!parsed.success) {
      return NextResponse.json(
        {
          error: parsed.error.issues[0]?.message || "Invalid result data.",
        },
        {
          status: 400,
        },
      );
    }

    const { eventId, results, markCompleted } = parsed.data;

    const event = await prisma.event.findUnique({
      where: {
        id: eventId,
      },
      select: {
        id: true,
        fights: {
          select: {
            id: true,
            fighterAId: true,
            fighterBId: true,
          },
        },
      },
    });

    if (!event) {
      return NextResponse.json(
        {
          error: "Event not found.",
        },
        {
          status: 404,
        },
      );
    }

    const fightsById = new Map(
      event.fights.map((fight) => {
        return [fight.id, fight];
      }),
    );

    for (const result of results) {
      const fight = fightsById.get(result.fightId);

      if (!fight) {
        return NextResponse.json(
          {
            error: "One of the results is for a fight outside this event.",
          },
          {
            status: 400,
          },
        );
      }

      if (result.status === "WINNER") {
        const winnerIsInFight =
          result.winnerFighterId === fight.fighterAId ||
          result.winnerFighterId === fight.fighterBId;

        if (!result.winnerFighterId || !winnerIsInFight) {
          return NextResponse.json(
            {
              error: "Winner must be one of the fighters in the fight.",
            },
            {
              status: 400,
            },
          );
        }
      }

      if (result.status !== "WINNER" && result.winnerFighterId) {
        return NextResponse.json(
          {
            error: "Only winner results can have a winner.",
          },
          {
            status: 400,
          },
        );
      }
    }

    await prisma.$transaction([
      ...results.map((result) => {
        const isWinner = result.status === "WINNER";

        return prisma.fightResult.upsert({
          where: {
            fightId: result.fightId,
          },
          create: {
            fightId: result.fightId,
            status: result.status,
            winnerFighterId: isWinner ? result.winnerFighterId : null,
            method: isWinner ? result.method : null,
            round: isWinner ? result.round : null,
          },
          update: {
            status: result.status,
            winnerFighterId: isWinner ? result.winnerFighterId : null,
            method: isWinner ? result.method : null,
            round: isWinner ? result.round : null,
          },
        });
      }),

      ...(markCompleted
        ? [
            prisma.event.update({
              where: {
                id: eventId,
              },
              data: {
                status: "COMPLETED",
              },
            }),
          ]
        : []),
    ]);

    return NextResponse.json({
      ok: true,
    });
  } catch (error) {
    console.error(error);

    return NextResponse.json(
      {
        error: "Failed to update results.",
      },
      {
        status: 500,
      },
    );
  }
}
4. Make sure your user is admin
In Prisma Studio, open User and set your account:

role = ADMIN
Or use SQL:

UPDATE "User"
SET "role" = 'ADMIN'
WHERE "email" = 'your-email@example.com';
5. Test
Open:

/admin
Pick results, click Save results, then go to:

/leaderboard
The leaderboard should update automatically.

One important thing: if you check Mark event completed, your /picks page will become locked because event status changes from OPEN to COMPLETED. That is probably what you want after results are final.


if i try go to /admin i get forwared to /picks

Thought for 6s
That means your logged-in session still thinks your user is:

role = USER
Most likely you changed yourself to ADMIN in Prisma Studio after logging in, so the JWT session still has the old role.

Quick fix first
Go to Prisma Studio.

Open User.

Make sure your account has:

role = ADMIN
Log out.

Log back in.

Try:

/admin
That will probably fix it.

Better fix: check admin role from database
This avoids stale session role problems.

Replace the top part of app/admin/page.tsx.

Change this:

const session = await auth();

if (!session?.user?.id) {
  redirect("/login");
}

if (session.user.role !== "ADMIN") {
  redirect("/picks");
}
to this:

const session = await auth();

if (!session?.user?.id) {
  redirect("/login");
}

const currentUser = await prisma.user.findUnique({
  where: {
    id: session.user.id,
  },
  select: {
    role: true,
  },
});

if (currentUser?.role !== "ADMIN") {
  redirect("/picks");
}
Now /admin checks your real database role, not the possibly stale login token.

Also update the admin API
In app/api/admin/results/route.ts, change this:

if (session.user.role !== "ADMIN") {
  return NextResponse.json(
    {
      error: "You are not allowed to update results.",
    },
    {
      status: 403,
    },
  );
}
to this:

const currentUser = await prisma.user.findUnique({
  where: {
    id: session.user.id,
  },
  select: {
    role: true,
  },
});

if (currentUser?.role !== "ADMIN") {
  return NextResponse.json(
    {
      error: "You are not allowed to update results.",
    },
    {
      status: 403,
    },
  );
}
Check one more thing
If you still have middleware.ts or proxy.ts, delete it for now:

rm -f middleware.ts proxy.ts
Then restart:

npm run dev
Most likely the only thing you need is: set role to ADMIN, then log out and log back in.


ok works.... now what should i do before putting this on github and somehow putting it on the web?

Thought for 10s
Before GitHub/deploy, I’d do this checklist in order.

1. Clean up secrets before GitHub
Make sure these are not committed:

.env
.env.local
DATABASE_URL
AUTH_SECRET
INVITE_CODE
Your .gitignore should include:

.env
.env.*
!.env.example
.next
node_modules
Then create a safe .env.example:

DATABASE_URL=""
AUTH_SECRET=""
INVITE_CODE=""
AUTH_TRUST_HOST=true
If you ever accidentally committed .env, don’t just delete it in a new commit. GitHub warns that sensitive data can remain in repository history unless you rewrite history and rotate the exposed secrets. 

2. Make sure the app builds locally
Run:

npm run lint
npm run build
If you do not have lint configured, at least run:

npx tsc --noEmit
npm run build
Fix every TypeScript/build error before deploy.

3. Add production scripts
In package.json, make sure you have something like:

{
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  }
}
For production, use prisma migrate deploy, not prisma migrate dev. Prisma documents migrate deploy as the production/staging command for applying pending migrations. 

4. Decide your first hosting setup
For this app, easiest stack:

GitHub repo
Vercel for Next.js hosting
Neon for Postgres
Vercel is built for Next.js and has project environment variables for secrets; Vercel stores env vars outside your code and encrypts them at rest. 

5. Prepare Neon for production
You have two choices:

Option A: Use your current Neon DB
Fastest, but your dev testing data goes live.

Option B: Create a new Neon branch/database for production
Cleaner. Recommended.

You’ll need production env vars:

DATABASE_URL="your-neon-production-url"
AUTH_SECRET="new-production-secret"
INVITE_CODE="your-real-friend-invite-code"
AUTH_TRUST_HOST=true
Auth.js notes that AUTH_TRUST_HOST=true is needed behind reverse proxies, and it may be inferred automatically on supported providers like Vercel, but setting it is fine. 

6. Add a seed/admin plan
Right now your admin access depends on changing your user role in Prisma Studio. On production, you need a clean way to make yourself admin.

Simplest MVP plan:

Deploy.

Sign up with your email.

Open Neon SQL editor.

Run:

UPDATE "User"
SET "role" = 'ADMIN'
WHERE "email" = 'your-email@example.com';
Better later: add an admin seed script using an ADMIN_EMAIL env var.

7. Do a quick security pass
Before sharing the URL with friends, check:

Can logged-out users access /picks? They should redirect to /login.
Can normal users access /admin? They should redirect to /picks.
Can normal users call /api/admin/results? It should return 403.
Can someone submit picks twice? It should return 409.
Can someone submit picks after lockAt? It should return 403.
Can someone sign up without INVITE_CODE? It should fail.
Also consider changing INVITE_CODE before sharing if you used a test one.

8. Commit to GitHub
From your project root:

git init
git status
git add .
git commit -m "Initial Pick Fights app"
Then create a GitHub repo and push:

git branch -M main
git remote add origin https://github.com/YOUR_USERNAME/YOUR_REPO.git
git push -u origin main
Start private if you’re unsure. You can make it public later.

9. Deploy on Vercel
On Vercel:

New Project
Import GitHub repo
Set environment variables
Deploy
Add these env vars in Vercel:

DATABASE_URL=
AUTH_SECRET=
INVITE_CODE=
AUTH_TRUST_HOST=true
Next.js supports loading environment variables through .env* locally, but in production they should be configured in the hosting provider, not committed. 

10. Run migrations in production
After deploy, your production database needs the migrations applied.

Best simple way: add this Vercel build command:

npx prisma migrate deploy && npx prisma generate && next build
Or keep build as:

npm run build
and make build in package.json:

"build": "prisma migrate deploy && prisma generate && next build"
Prisma also recommends running migrate deploy in the CI/CD pipeline for production changes. 

11. Final production test
After deploy:

Sign up
Log in
Set profile picture
Submit picks
Confirm picks lock
Promote yourself to ADMIN in Neon
Log out/in
Go to /admin
Enter fake result
Check /leaderboard
The biggest things before GitHub are: do not commit .env, make sure npm run build passes, and use prisma migrate deploy for production.


wait slower

Totally — slow down.

Right now, before GitHub or deployment, do only this first:

Step A: make sure secrets are safe
In your project root, check if you have a file named:

.gitignore
Open it and make sure it contains these lines:

.env
.env.*
!.env.example
.next
node_modules
This matters because your .env has stuff like:

DATABASE_URL
AUTH_SECRET
INVITE_CODE
You do not want those on GitHub.

Then create a safe example file named:

.env.example
Put this inside:

DATABASE_URL=""
AUTH_SECRET=""
INVITE_CODE=""
AUTH_TRUST_HOST=true
Do that first. After that, we’ll move to the next tiny step: checking whether Git will accidentally include your .env.


