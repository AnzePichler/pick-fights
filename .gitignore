Thought for 45s
Replace your app/picks/page.tsx with this version. This avoids the event.submissions typing issue by fetching the submission separately.

// app/picks/page.tsx
import { redirect } from "next/navigation";

import { auth } from "@/auth";
import { prisma } from "@/lib/prisma";
import FightAccordion from "@/components/picks/FightAccordion";
import Navbar from "@/components/Navbar";
import type { PickDraft } from "@/components/picks/types";

export const dynamic = "force-dynamic";

export default async function PicksPage() {
  const session = await auth();

  if (!session?.user?.id) {
    redirect("/login");
  }

  const event = await prisma.event.findFirst({
    where: {
      isActive: true,
    },
    include: {
      fights: {
        include: {
          fighterA: true,
          fighterB: true,
        },
        orderBy: {
          order: "asc",
        },
      },
    },
  });

  if (!event) {
    return (
      <>
        <Navbar />

        <main className="min-h-screen bg-zinc-100 p-6 text-black">
          <section className="mx-auto max-w-5xl rounded-3xl bg-white p-8 shadow-sm">
            <h1 className="text-3xl font-black">No active event yet.</h1>
            <p className="mt-2 text-neutral-500">
              Once an event is active, picks will show up here.
            </p>
          </section>
        </main>
      </>
    );
  }

  const existingSubmission = await prisma.pickSubmission.findUnique({
    where: {
      userId_eventId: {
        userId: session.user.id,
        eventId: event.id,
      },
    },
    include: {
      choices: true,
    },
  });

  const initialPicks: Record<string, PickDraft> = {};

  if (existingSubmission) {
    for (const choice of existingSubmission.choices) {
      initialPicks[choice.fightId] = {
        fighterId: choice.pickedFighterId,
      };
    }
  }

  const now = new Date();

  const picksAreLocked =
    Boolean(existingSubmission) ||
    event.status !== "OPEN" ||
    event.lockAt.getTime() <= now.getTime();

  return (
    <>
      <Navbar />

      <main className="min-h-screen bg-zinc-100 p-6 text-black">
        <section className="mx-auto max-w-5xl">
          <div className="mb-6 rounded-3xl bg-white p-6 shadow-sm">
            <h1 className="text-3xl font-black">{event.name}</h1>

            {existingSubmission ? (
              <p className="mt-2 text-sm font-semibold text-neutral-500">
                Your picks are submitted and locked. You can still open each
                fight to view the details.
              </p>
            ) : picksAreLocked ? (
              <p className="mt-2 text-sm font-semibold text-neutral-500">
                Picks are closed for this event.
              </p>
            ) : (
              <p className="mt-2 text-sm font-semibold text-neutral-500">
                Pick one fighter for every fight. Once submitted, picks are
                locked.
              </p>
            )}
          </div>

          <FightAccordion
            eventId={event.id}
            fights={event.fights}
            initialPicks={initialPicks}
            isLocked={picksAreLocked}
          />
        </section>
      </main>
    </>
  );
}
Now update components/picks/FightAccordion.tsx so initialPicks and isLocked are valid props:

// components/picks/FightAccordion.tsx
"use client";

import { useRouter } from "next/navigation";
import { useState } from "react";

import FightCard from "./FightCard";
import SubmitPicksButton from "./SubmitPicksButton";
import type { Fight, PickDraft } from "./types";

type Props = {
  eventId: string;
  fights: Fight[];
  initialPicks?: Record<string, PickDraft>;
  isLocked?: boolean;
};

export default function FightAccordion({
  eventId,
  fights,
  initialPicks = {},
  isLocked = false,
}: Props) {
  const router = useRouter();

  const [selectedPicks, setSelectedPicks] =
    useState<Record<string, PickDraft>>(initialPicks);

  const [isSubmitting, setIsSubmitting] = useState(false);
  const [hasSubmitted, setHasSubmitted] = useState(false);

  function selectFighter(fightId: string, fighterId: string) {
    if (isLocked || hasSubmitted || isSubmitting) {
      return;
    }

    setSelectedPicks((current) => {
      const alreadySelected = current[fightId]?.fighterId === fighterId;

      if (alreadySelected) {
        const updated = { ...current };
        delete updated[fightId];
        return updated;
      }

      return {
        ...current,
        [fightId]: {
          fighterId,
        },
      };
    });
  }

  async function submitPicks() {
    if (isLocked || hasSubmitted || isSubmitting) {
      return;
    }

    const choices = Object.entries(selectedPicks).map(([fightId, pick]) => ({
      fightId,
      pickedFighterId: pick.fighterId,
    }));

    setIsSubmitting(true);

    try {
      const response = await fetch("/api/picks/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          eventId,
          choices,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        alert(data.error || "Failed to submit picks.");
        return;
      }

      setHasSubmitted(true);
      alert("Picks submitted and locked!");
      router.refresh();
    } catch (error) {
      console.error(error);
      alert("Failed to submit picks.");
    } finally {
      setIsSubmitting(false);
    }
  }

  const totalFights = fights.length;
  const pickedCount = Object.keys(selectedPicks).length;
  const allPicksMade = pickedCount === totalFights;
  const locked = isLocked || hasSubmitted;

  return (
    <>
      <div className="space-y-5 pb-32">
        {fights.map((fight) => (
          <FightCard
            key={fight.id}
            fight={fight}
            selectedFighterId={selectedPicks[fight.id]?.fighterId}
            onSelectFighter={selectFighter}
            isLocked={locked}
          />
        ))}
      </div>

      <SubmitPicksButton
        pickedCount={pickedCount}
        totalFights={totalFights}
        disabled={!allPicksMade || isSubmitting || locked}
        isSubmitting={isSubmitting}
        isLocked={locked}
        onSubmit={submitPicks}
      />
    </>
  );
}

