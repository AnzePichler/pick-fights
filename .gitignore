9. Move your current event page to app/picks/page.tsx
Take your current app/test-event/page.tsx logic and replace it with this. This protects the page and redirects logged-out users.

// app/picks/page.tsx
import { redirect } from "next/navigation";

import { auth } from "@/auth";
import { prisma } from "@/lib/prisma";
import FightAccordion from "@/components/picks/FightAccordion";
import Navbar from "@/components/Navbar";

export const dynamic = "force-dynamic";

export default async function PicksPage() {
  const session = await auth();

  if (!session?.user) {
    redirect("/login");
  }

  const event = await prisma.event.findFirst({
    where: {
      isActive: true,
    },
    include: {
      fights: {
        include: {
          fighterA: true,
          fighterB: true,
        },
        orderBy: {
          order: "asc",
        },
      },
      submissions: {
        where: {
          userId: session.user.id,
        },
        include: {
          choices: true,
        },
        take: 1,
      },
    },
  });

  if (!event) {
    return (
      <>
        <Navbar />

        <main className="min-h-screen bg-zinc-100 p-6 text-black">
          <section className="mx-auto max-w-5xl rounded-3xl bg-white p-8 shadow-sm">
            <h1 className="text-3xl font-black">No active event yet.</h1>
            <p className="mt-2 text-neutral-500">
              Once an event is active, picks will show up here.
            </p>
          </section>
        </main>
      </>
    );
  }

  const existingSubmission = event.submissions[0] || null;

  if (existingSubmission) {
    return (
      <>
        <Navbar />

        <main className="min-h-screen bg-zinc-100 p-6 text-black">
          <section className="mx-auto max-w-5xl rounded-3xl bg-white p-8 shadow-sm">
            <h1 className="text-3xl font-black">Your picks are locked.</h1>

            <p className="mt-2 text-neutral-500">
              You already submitted picks for {event.name}. No changes allowed.
            </p>

            <div className="mt-8 space-y-4">
              {event.fights.map((fight) => {
                const choice = existingSubmission.choices.find(
                  (item) => item.fightId === fight.id,
                );

                const pickedFighter =
                  choice?.pickedFighterId === fight.fighterA.id
                    ? fight.fighterA
                    : choice?.pickedFighterId === fight.fighterB.id
                      ? fight.fighterB
                      : null;

                return (
                  <div
                    key={fight.id}
                    className="rounded-2xl border border-neutral-200 p-5"
                  >
                    <div className="font-black text-neutral-800">
                      {fight.fighterA.name} vs {fight.fighterB.name}
                    </div>

                    <div className="mt-1 text-sm font-semibold text-neutral-500">
                      Your pick: {pickedFighter?.name || "Unknown"}
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        </main>
      </>
    );
  }

  const now = new Date();
  const picksAreClosed =
    event.status !== "OPEN" || event.lockAt.getTime() <= now.getTime();

  if (picksAreClosed) {
    return (
      <>
        <Navbar />

        <main className="min-h-screen bg-zinc-100 p-6 text-black">
          <section className="mx-auto max-w-5xl rounded-3xl bg-white p-8 shadow-sm">
            <h1 className="text-3xl font-black">Picks are closed.</h1>
            <p className="mt-2 text-neutral-500">
              The picks window for {event.name} is locked.
            </p>
          </section>
        </main>
      </>
    );
  }

  return (
    <>
      <Navbar />

      <main className="min-h-screen bg-zinc-100 p-6 text-black">
        <section className="mx-auto max-w-5xl">
          <div className="mb-6 rounded-3xl bg-white p-6 shadow-sm">
            <h1 className="text-3xl font-black">{event.name}</h1>
            <p className="mt-2 text-sm font-semibold text-neutral-500">
              Pick one fighter for every fight. Once submitted, picks are locked.
            </p>
          </div>

          <FightAccordion eventId={event.id} fights={event.fights} />
        </section>
      </main>
    </>
  );
}
Important: this uses isActive: true, so in Prisma Studio make sure your current event has:

isActive = true
status = OPEN
Also make sure lockAt is in the future while testing.

10. Create middleware.ts
This protects /picks, /account, and /admin.

// middleware.ts
import { NextResponse } from "next/server";

import { auth } from "@/auth";

export default auth((request) => {
  const { nextUrl } = request;
  const user = request.auth?.user;

  const isAuthPage =
    nextUrl.pathname.startsWith("/login") ||
    nextUrl.pathname.startsWith("/signup");

  const requiresLogin =
    nextUrl.pathname.startsWith("/picks") ||
    nextUrl.pathname.startsWith("/account") ||
    nextUrl.pathname.startsWith("/admin");

  if (isAuthPage && user) {
    return NextResponse.redirect(new URL("/picks", nextUrl));
  }

  if (requiresLogin && !user) {
    return NextResponse.redirect(new URL("/login", nextUrl));
  }

  if (nextUrl.pathname.startsWith("/admin") && user?.role !== "ADMIN") {
    return NextResponse.redirect(new URL("/picks", nextUrl));
  }

  return NextResponse.next();
});

export const config = {
  matcher: ["/login", "/signup", "/picks/:path*", "/account/:path*", "/admin/:path*"],
};
One note: Auth.js docs say that in Next.js 16, middleware.ts has been renamed to proxy.ts; for older App Router versions, middleware.ts is still the normal file. 

11. Promote yourself to admin
After you sign up, open Prisma Studio and change your user:

role = ADMIN
Or run SQL:

UPDATE "User"
SET "role" = 'ADMIN'
WHERE "email" = 'your-email@example.com';
